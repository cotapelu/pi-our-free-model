# Our Free Model - Environment Configuration
# Copy this file to .env and adjust values as needed

# Data directory (stores settings, keys, cache, etc.)
# Default: ~/.our-free-model
OFM_DATA_DIR=/var/lib/ofm

# Gateway server
OFM_GATEWAY_PORT=18900
OFM_GATEWAY_HOST=127.0.0.1
# API key (auto-generated if not set)
# OFM_GATEWAY_KEY=ofm-your-secret-key-here

# LAN relay (for standalone service)
OFM_LAN_ENABLED=false
OFM_LAN_PORT=0

# Logging
# Levels: fatal, error, warn, info, debug, trace
OFM_LOG_LEVEL=info

# Standalone service
# Skip automatic model refresh on startup
OFM_NO_REFRESH=false

# Desktop auto-update version
# OFM_DESKTOP_VERSION=2.8.3