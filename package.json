{
  "name": "dsh-our-free-model",
  "version": "2.7.4",
  "private": true,
  "type": "module",
  "description": "pi provider extension for the two keyless free-model lanes this repository documents: OpenCode's public free tier and Kilo AI's public gateway free pool. No login, no sign-up, no API key. The dsh-plugin half has been dropped — this package ships and tests ./pi-extension only.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ebony-Vinyl/dsh-our-free-model.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run test:pi-extension",
    "test:pi-extension": "npm --prefix pi-extension run test:pi-extension",
    "verify:pi-extension-upstream": "npm --prefix pi-extension run verify:pi-extension-upstream",
    "typecheck:pi-extension-strict": "npm --prefix pi-extension run typecheck:strict"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "free-model",
    "llm-provider"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
