{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["*.ts", "client/**/*.ts", "core/**/*.ts", "gateway/**/*.ts", "o2a/**/*.ts", "packages/**/*.ts", "token-saver/**/*.ts", "worker/**/*.ts"],
  "exclude": ["test", "scripts", "dist", "node_modules", "packages/standalone/frontend", "client/sponsor-ui.ts"]
}
