{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@ofm/core/*": ["packages/core/*"],
      "@ofm/gateway/*": ["packages/gateway/*"],
      "@ofm/provider/*": ["packages/provider/*"],
      "@ofm/standalone/*": ["packages/standalone/*"],
      "@ofm/console/*": ["packages/console/*"],
      "@ofm/shared/*": ["packages/shared/*"],
      "@ofm/desktop/*": ["packages/desktop/*"],
      "@ofm/worker/*": ["packages/worker/*"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "config/**/*.ts"],
  "exclude": [
    "tests",
    "scripts",
    "dist",
    "node_modules",
    "packages/standalone/frontend",
    "packages/console/sponsor-ui.ts",
    "packages/console/**",
    "packages/standalone/**",
    "vendor/**"
  ]
}
